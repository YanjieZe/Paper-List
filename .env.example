# PostgreSQL database dedicated to Paper-List Research OS.
DATABASE_URL=postgresql://paper_os:change-me@127.0.0.1:5432/paper_os

# Single-user authentication. Generate via stdin; avoid placing the password in shell history.
PAPER_ADMIN_USERNAME=yz
PAPER_ADMIN_PASSWORD_HASH=
PAPER_SESSION_SECRET=
PAPER_PUBLIC_URL=http://localhost:3000

# OpenAI credentials are loaded from the process environment. Never commit a value here.
OPENAI_API_KEY=
OPENAI_AGENTS_DONT_LOG_MODEL_DATA=1
OPENAI_AGENTS_DONT_LOG_TOOL_DATA=1
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=0

# Private runtime storage; ignored by Git.
PAPER_STORAGE_DIR=./var/storage
PAPER_REPOSITORY_ROOT=.
PAPER_WORKER_ID=local-worker

# Model-role registry.
PAPER_MODEL_FAST=gpt-5.6-luna
PAPER_MODEL_STANDARD=gpt-5.6-terra
PAPER_MODEL_DEEP=gpt-5.6-sol
PAPER_MODEL_EMBEDDING=text-embedding-3-large
PAPER_EMBEDDING_DIMENSIONS=1536

# Per-task USD hard limits.
PAPER_BUDGET_TRIAGE_USD=0.10
PAPER_BUDGET_STANDARD_USD=1.00
PAPER_BUDGET_DEEP_USD=5.00
PAPER_BUDGET_RESEARCH_USD=10.00
PAPER_BUDGET_ROADMAP_USD=20.00
PAPER_WEB_SEARCH_COST_USD=0.01

# Encrypted backups. Keep the age identity off this server.
PAPER_BACKUP_DIR=/var/backups/paper-os
PAPER_BACKUP_AGE_RECIPIENT=
# Fallback when age is unavailable. Prefer an age recipient in production.
PAPER_BACKUP_OPENSSL_PASSPHRASE=
PAPER_BACKUP_RCLONE_REMOTE=
