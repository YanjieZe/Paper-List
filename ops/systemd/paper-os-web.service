[Unit]
Description=Paper-List Research OS web
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=paper-os
Group=paper-os
WorkingDirectory=/opt/paper-list
EnvironmentFile=/etc/paper-os/paper-os.env
ExecStart=/usr/bin/npm --workspace web start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/paper-list/var

[Install]
WantedBy=multi-user.target
